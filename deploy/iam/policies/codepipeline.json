{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseGitHubConnection",
      "Effect": "Allow",
      "Action": "codeconnections:UseConnection",
      "Resource": "${CODECONNECTION_ARN}"
    },
    {
      "Sid": "ReadWritePipelineArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": [
        "${ARTIFACT_BUCKET_ARN}",
        "${ARTIFACT_BUCKET_ARN}/*"
      ]
    },
    {
      "Sid": "RunBuilds",
      "Effect": "Allow",
      "Action": [
        "codebuild:BatchGetBuilds",
        "codebuild:StartBuild"
      ],
      "Resource": [
        "${CODEBUILD_EC2_PROJECT_ARN}",
        "${CODEBUILD_ECS_PROJECT_ARN}"
      ]
    },
    {
      "Sid": "DeployToEC2",
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateDeployment",
        "codedeploy:GetApplicationRevision",
        "codedeploy:GetDeployment",
        "codedeploy:GetDeploymentConfig",
        "codedeploy:RegisterApplicationRevision"
      ],
      "Resource": [
        "${CODEDEPLOY_APPLICATION_ARN}",
        "${CODEDEPLOY_DEPLOYMENT_GROUP_ARN}",
        "${CODEDEPLOY_DEPLOYMENT_CONFIG_ARN}"
      ]
    },
    {
      "Sid": "DeployToECS",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition",
        "ecs:UpdateService"
      ],
      "Resource": [
        "${ECS_SERVICE_ARN}",
        "${ECS_TASK_DEFINITION_ARN}"
      ]
    },
    {
      "Sid": "PassECSRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "${TASK_EXECUTION_ROLE_ARN}",
        "${TASK_ROLE_ARN}"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}

